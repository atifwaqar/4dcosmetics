{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "slug", "images", "price", "categories", "shortDescription", "descriptionHTML", "inStock"],
    "properties": {
      "id": {"type": "string"},
      "name": {"type": "string"},
      "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
      "images": {
        "type": "array",
        "items": {"type": "string"}
      },
      "price": {
        "type": "object",
        "required": ["current", "currency"],
        "properties": {
          "current": {"type": "number"},
          "old": {"type": ["number", "null"]},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
        },
        "additionalProperties": false
      },
      "categories": {
        "type": "array",
        "items": {"type": "string"}
      },
      "brand": {"type": "string"},
      "tags": {
        "type": "array",
        "items": {"type": "string"}
      },
      "shortDescription": {"type": "string"},
      "descriptionHTML": {"type": "string"},
      "inStock": {"type": "boolean"},
      "sku": {"type": "string"},
      "variants": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": {"type": "string"},
            "name": {"type": "string"},
            "color": {"type": "string"},
            "image": {"type": "string"},
            "price": {"type": "number"},
            "inStock": {"type": "boolean"},
            "sku": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "details": {
        "type": "array",
        "items": {"type": "string"}
      },
      "howTo": {
        "type": "array",
        "items": {"type": "string"}
      },
      "ingredients": {"type": "string"},
      "goodToKnow": {"type": "string"},
      "shippingReturns": {"type": "string"}
    },
    "additionalProperties": false
  }
}
