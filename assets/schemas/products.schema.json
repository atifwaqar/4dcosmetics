{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "slug", "images", "price", "currency", "categories", "shortDescription", "descriptionHTML", "inStock"],
    "properties": {
      "id": {"type": "string"},
      "name": {"type": "string"},
      "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
      "images": {
        "type": "array",
        "items": {"type": "string"}
      },
      "price": {"type": "number"},
      "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
      "categories": {
        "type": "array",
        "items": {"type": "string"}
      },
      "brand": {"type": "string"},
      "tags": {
        "type": "array",
        "items": {"type": "string"}
      },
      "shortDescription": {"type": "string"},
      "descriptionHTML": {"type": "string"},
      "inStock": {"type": "boolean"},
      "sku": {"type": "string"}
    },
    "additionalProperties": false
  }
}
